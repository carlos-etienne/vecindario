---
import taps from '../data/taps.json';
import BeerGlass from './BeerGlass.astro';

interface Props {
  variant?: 'compact' | 'full';
}
const { variant = 'compact' } = Astro.props;
---

{variant === 'compact' ? (
  <div class="tapwall-card">
    <div class="tapwall-bar">
      <span class="tw-live">CERVEZA DE BARRIL · EN ROTACIÓN</span>
      <span class="tw-updated">10 líneas</span>
    </div>
    <div class="tap-grid-compact">
      {taps.map((tap) => (
        <div class={`tap-c${!tap.disponible ? ' agotada' : ''}`}>
          <div class="tap-c-numwrap">
            <span class="tap-c-num">#{String(tap.num).padStart(2, '0')}</span>
            <BeerGlass color={tap.color} size={26} />
          </div>
          <div class="tap-c-info">
            <div class="tap-c-name">{tap.nombre}</div>
            <div class="tap-c-meta">{tap.estilo} · {tap.abv}</div>
            <div class="tap-c-brew">{tap.cerveceria} · {tap.origen.split(',')[0]}</div>
          </div>
          <div class="tap-c-prices">
            {tap.disponible ? (
              <>
                <span class="p-ch">${tap.precioCh}<small>CH</small></span>
                <span class="p-sep">·</span>
                <span class="p-g">${tap.precioG}<small>G</small></span>
              </>
            ) : (
              <span style="color:#9a9183;">Agotada</span>
            )}
          </div>
        </div>
      ))}
    </div>
    <div class="tap-slider-nav">
      <button class="ts-btn ts-prev" aria-label="Cerveza anterior">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <div class="ts-dots">
        {taps.map((t) => <button class="ts-dot" aria-label={`Ir a la cerveza #${t.num}`} />)}
      </div>
      <button class="ts-btn ts-next" aria-label="Cerveza siguiente">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>
    <div class="tapwall-bar bottom">
      <a href="/cerveza-artesanal-cuernavaca/" class="tw-link">Conoce nuestra selección de cerveza artesanal →</a>
      <span class="tw-updated">CH = chico · G = grande</span>
    </div>
  </div>
) : (
  <div class="tapwall">
    <div class="tapwall-bar">
      <span class="tw-live">10 LÍNEAS EN SERVICIO</span>
      <span class="tw-updated">CH = chico · G = grande</span>
    </div>
    <div class="tapwall-grid">
      {taps.map((tap) => (
        <div class={`tap-row-full${!tap.disponible ? ' agotada' : ''}`}>
          <div class="tap-num-wrap">
            <span class="tap-num-full">#{String(tap.num).padStart(2, '0')}</span>
            <BeerGlass color={tap.color} size={32} />
          </div>
          <div class="tap-main-full">
            <div class="tap-topline">
              <span class="tap-name-full">
                {tap.nombre}
                {tap.badges.map((b) => (
                  <span class={`tap-badge-full ${b.toLowerCase()}`}>{b}</span>
                ))}
              </span>
              <span class="tap-prices-full">
                {tap.disponible ? (
                  <>
                    <span class="tap-price-line">${tap.precioCh}<small>CH</small></span>
                    <span class="tap-price-line">${tap.precioG}<small>G</small></span>
                  </>
                ) : (
                  <span class="tap-price-line agotada-txt">Agotada</span>
                )}
              </span>
            </div>
            <div class="tap-style-full">{tap.estilo}</div>
            <div class="tap-meta-full">{tap.cerveceria} · {tap.origen} · {tap.abv} ABV{tap.ibu ? ` · ${tap.ibu} IBU` : ''}</div>
            {tap.descripcion && <div class="tap-desc-full">{tap.descripcion}</div>}
          </div>
        </div>
      ))}
    </div>
  </div>
)}

<style>
  /* === COMPACT (home) === */
  .tapwall-card {
    background: var(--vbg-negro);
    border: 1px solid rgba(255,255,255,0.08);
    border-top: 3px solid var(--vbg-ambar);
    border-radius: 4px;
    box-shadow: 0 -10px 40px rgba(0,0,0,0.4), 0 20px 50px rgba(0,0,0,0.25);
    overflow: hidden;
  }
  .tap-grid-compact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: repeat(5, auto);
    grid-auto-flow: column;
  }
  .tap-c {
    display: grid;
    grid-template-columns: 82px 1fr auto;
    gap: 0.7rem; align-items: center;
    padding: 0.7rem 1rem;
    border-right: 1px solid rgba(255,255,255,0.05);
    border-bottom: 1px solid rgba(255,255,255,0.05);
    transition: background 0.15s;
  }
  .tap-c:nth-child(n+6) { border-right: none; }
  .tap-c:nth-child(5), .tap-c:nth-child(10) { border-bottom: none; }
  .tap-c:hover { background: rgba(196,114,30,0.06); }
  .tap-c.agotada { opacity: 0.4; }
  .tap-c-numwrap { display: flex; flex-direction: row; align-items: center; gap: 0.3rem; }
  .tap-c-num {
    font-family: 'Anton', sans-serif; font-size: 1.2rem;
    color: var(--vbg-ambar); line-height: 0.85; letter-spacing: -0.03em;
  }
  .tap-c-info .tap-c-name {
    font-weight: 600; color: #f3ebd9; font-size: 0.86rem;
    margin-bottom: 0.1rem; line-height: 1.2;
  }
  .tap-c-info .tap-c-meta {
    font-family: 'JetBrains Mono', monospace; font-size: 0.66rem;
    color: var(--vbg-verde-claro); font-weight: 500;
  }
  .tap-c-info .tap-c-brew {
    font-family: 'JetBrains Mono', monospace; font-size: 0.6rem;
    color: #9a9183; text-transform: uppercase; letter-spacing: 0.03em;
  }
  .tap-c-prices {
    font-family: 'JetBrains Mono', monospace; font-size: 0.78rem;
    text-align: right; white-space: nowrap;
  }
  .tap-c-prices .p-ch, .tap-c-prices .p-g {
    color: var(--vbg-verde-claro); font-weight: 600;
  }
  .tap-c-prices small {
    color: #9a9183; font-size: 0.56rem; margin-left: 0.15rem;
  }
  .tap-c-prices .p-sep { color: rgba(255,255,255,0.2); margin: 0 0.2rem; }

  /* === FULL (menú) === */
  .tapwall {
    background: var(--vbg-negro); color: #f3ebd9;
    border-radius: 4px; overflow: hidden;
    border: 1px solid rgba(255,255,255,0.08);
    border-top: 3px solid var(--vbg-ambar);
    box-shadow: 0 8px 30px rgba(0,0,0,0.15);
  }
  .tapwall-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: repeat(5, auto);
    grid-auto-flow: column;
  }
  .tap-row-full {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 0.8rem; align-items: start;
    padding: 0.9rem 1rem;
    border-right: 1px solid rgba(255,255,255,0.06);
    border-bottom: 1px solid rgba(255,255,255,0.06);
    transition: background 0.15s;
  }
  /* el grid llena por columnas (1-5 izq, 6-10 der): sin borde derecho solo en la última columna,
     sin borde inferior solo en el fondo de cada columna */
  .tap-row-full:nth-child(n+6) { border-right: none; }
  .tap-row-full:nth-child(5), .tap-row-full:nth-child(10) { border-bottom: none; }
  .tap-row-full:hover { background: rgba(196,114,30,0.05); }
  .tap-row-full.agotada { opacity: 0.45; }
  .tap-num-wrap { display: flex; flex-direction: row; align-items: center; gap: 0.35rem; padding-top: 0.15rem; }
  .tap-num-full {
    font-family: 'Anton', sans-serif; font-size: 1.8rem;
    color: var(--vbg-ambar); line-height: 0.85; letter-spacing: -0.03em;
  }
  .tap-topline {
    display: flex; justify-content: space-between; align-items: baseline;
    gap: 0.8rem; flex-wrap: wrap; margin-bottom: 0.2rem;
  }
  .tap-name-full {
    font-weight: 600; color: #f3ebd9; font-size: 1rem;
    display: inline-flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;
  }
  .tap-style-full {
    font-family: 'JetBrains Mono', monospace; font-size: 0.8rem;
    color: var(--vbg-verde-claro); font-weight: 500; margin-bottom: 0.15rem;
  }
  .tap-meta-full {
    font-family: 'JetBrains Mono', monospace; font-size: 0.68rem;
    color: #9a9183; text-transform: uppercase; letter-spacing: 0.05em;
    margin-bottom: 0.4rem;
  }
  .tap-desc-full {
    font-size: 0.78rem; color: #c8c0b0; line-height: 1.45;
    font-style: italic;
  }
  .tap-badge-full {
    display: inline-block; font-family: 'JetBrains Mono', monospace; font-size: 0.58rem;
    color: var(--vbg-ambar); border: 1px solid var(--vbg-ambar);
    padding: 0.1rem 0.4rem; border-radius: 2px; letter-spacing: 0.06em; text-transform: uppercase;
  }
  .tap-badge-full.collab { color: var(--vbg-verde-claro); border-color: var(--vbg-verde-claro); }
  .tap-badge-full.new { color: #fff; border-color: var(--vbg-ambar); background: var(--vbg-ambar); }
  .tap-badge-full.agotada { color: #9a9183; border-color: #9a9183; }
  .tap-prices-full {
    display: flex; align-items: baseline; gap: 0.6rem;
    font-family: 'JetBrains Mono', monospace; white-space: nowrap; margin-left: auto;
  }
  .tap-price-line {
    color: var(--vbg-verde-claro); font-weight: 600; font-size: 0.93rem;
  }
  .tap-price-line small {
    color: #9a9183; font-weight: 400; font-size: 0.64rem; margin-left: 0.3rem; text-transform: uppercase;
  }
  .tap-price-line.agotada-txt { color: #9a9183; font-size: 0.8rem; }

  /* Slider nav (solo móvil) */
  .tap-slider-nav { display: none; }

  /* === Shared === */
  .tapwall-bar {
    display: flex; justify-content: space-between; align-items: center;
    padding: 0.7rem 1.2rem;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    font-family: 'JetBrains Mono', monospace; font-size: 0.68rem;
    letter-spacing: 0.12em; text-transform: uppercase;
  }
  .tapwall-bar.bottom {
    border-top: 1px solid rgba(255,255,255,0.06);
    border-bottom: none;
  }
  .tw-live { color: var(--vbg-verde-claro); }
  .tw-live::before { content: "●"; margin-right: 0.35rem; animation: pulse 2.5s infinite; }
  .tw-updated { color: #9a9183; }
  .tw-link { color: var(--vbg-ambar); font-weight: 600; }

  @media (max-width: 700px) {
    .tapwall-grid {
      grid-template-columns: 1fr;
      grid-auto-flow: row;
    }
    .tap-row-full { border-right: none !important; border-bottom: 1px solid rgba(255,255,255,0.06); }
    .tap-row-full:last-child { border-bottom: none; }
    /* Home: carrusel horizontal con snap — obvio que se desliza */
    .tap-grid-compact {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 0.6rem;
      padding: 0.8rem 1rem;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .tap-grid-compact::-webkit-scrollbar { display: none; }
    .tap-grid-compact .tap-c {
      flex: 0 0 84%;
      scroll-snap-align: center;
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 4px;
      padding: 0.9rem 1rem;
      background: rgba(255,255,255,0.03);
    }
    .tap-grid-compact .tap-c:nth-last-child(-n+2) { border-bottom: 1px solid rgba(255,255,255,0.08); }
    /* Navegación del slider: flechas + dots */
    .tap-slider-nav {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1.2rem;
      padding: 0.8rem 1rem 0.7rem;
      border-top: 1px solid rgba(255,255,255,0.06);
    }
    .ts-btn {
      background: rgba(255,255,255,0.1);
      border: 1px solid rgba(255,255,255,0.2);
      color: #f3ebd9;
      width: 42px;
      height: 42px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: background 0.2s;
    }
    .ts-btn:active { background: var(--vbg-verde-claro); }
    .ts-dots { display: flex; gap: 0.45rem; }
    .ts-dot {
      width: 8px; height: 8px;
      border-radius: 50%;
      background: rgba(255,255,255,0.2);
      border: none; padding: 0;
      cursor: pointer;
      transition: background 0.2s, transform 0.2s;
    }
    .ts-dot.active { background: var(--vbg-verde-claro); transform: scale(1.3); }

    /* tapwall-bar: solo estado live en móvil, sin amontonar */
    .tapwall-bar { padding: 0.6rem 0.8rem; }
    .tapwall-bar .tw-updated { display: none; }

    /* Full (menú): mismo layout compacto — num izquierda, contenido derecha */
    .tap-row-full {
      grid-template-columns: 64px 1fr;
      gap: 0.6rem;
      padding: 0.8rem;
      align-items: start;
    }
    .tap-num-full { font-size: 1.2rem; }
    .tap-name-full { font-size: 0.95rem; }
    .tap-style-full { font-size: 0.74rem; }
    .tap-meta-full { font-size: 0.62rem; }
    .tap-desc-full { font-size: 0.74rem; }
    .tap-price-line { font-size: 0.88rem; }
    .tap-topline { gap: 0.5rem; }

    /* Compact (home): mantener 2 columnas internas pero ajustado */
    .tap-c {
      grid-template-columns: 60px 1fr;
      padding: 0.6rem 0.8rem;
    }
    .tap-c-num { font-size: 1rem; }
    .tap-c-prices { grid-column: 2; text-align: left; font-size: 0.72rem; margin-top: 0.15rem; }
  }
</style>

<script>
  // Slider del tap wall (móvil): flechas + dots + swipe nativo
  const grid = document.querySelector('.tap-grid-compact');
  const dots = document.querySelectorAll('.ts-dot');
  const prev = document.querySelector('.ts-prev');
  const next = document.querySelector('.ts-next');
  if (grid && dots.length) {
    const step = () => {
      const card = grid.querySelector('.tap-c');
      return card ? card.offsetWidth + 10 : 300;
    };
    const setActive = () => {
      const idx = Math.min(dots.length - 1, Math.max(0, Math.round(grid.scrollLeft / step())));
      dots.forEach((d, i) => d.classList.toggle('active', i === idx));
    };
    next?.addEventListener('click', () => grid.scrollBy({ left: step(), behavior: 'smooth' }));
    prev?.addEventListener('click', () => grid.scrollBy({ left: -step(), behavior: 'smooth' }));
    dots.forEach((d, i) => d.addEventListener('click', () => grid.scrollTo({ left: i * step(), behavior: 'smooth' })));
    grid.addEventListener('scroll', setActive, { passive: true });
    setActive();
  }
</script>
