---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TapWall from '../../components/TapWall.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import site from '../../data/site.json';

const schema = {
  "@context": "https://schema.org",
  "@type": "Menu",
  "name": "Menú Vecindario Beer Garden",
  "hasMenuSection": [
    { "@type": "MenuSection", "name": "Cervezas de barril" },
    { "@type": "MenuSection", "name": "Alimentos" },
    { "@type": "MenuSection", "name": "Otras bebidas" }
  ]
};

const platos = {
  empezar: [
    { nombre: "Tostada de Atún Fresco", desc: "Cubos de atún marinados en ponzu de la casa, sobre cama de aguacate, chile serrano y poro crispy.", precio: 185, foto: "/images/tostadas-de-atun.jpg" },
    { nombre: "Ensalada Royal", desc: "Mezcla de lechugas, fresas, arándanos, zarzamoras, nuez caramelizada y queso gorgonzola, con reducción de vinagre balsámico.", precio: 185 },
    { nombre: "Ensalada primavera", desc: "Mix de lechugas, arúgula, cherries, brotes de betabel y chícharo, poro crujiente, nueces y parmesano. Proteína extra: pollo a la plancha o atún marinado en ponzu +$30.", precio: 165 },
    { nombre: "Nachos con Cecina", desc: "Cecina de Yecapixtla, frijoles negros, queso manchego, queso mozzarella, guacamole y crema.", precio: 195 },
    { nombre: "Calamares Empanizados", desc: "Con parmesano, acompañados de aderezo tártara.", precio: 170 },
    { nombre: "Arancinis", desc: "Bolas de risotto empanizadas rellenas de queso manchego (3 piezas de 70 g).", precio: 140 },
    { nombre: "Dedos de queso", desc: "Queso manchego empanizado, acompañado con aderezo de la casa (6 piezas).", precio: 110 },
    { nombre: "Guacamole", desc: "Versión clásica con cebolla, jitomate, cilantro y chile serrano.", precio: 115 },
    { nombre: "Guacamole con tocino crujiente", desc: "El guacamole de la casa coronado con tocino crujiente.", precio: 145 },
    { nombre: "Papas Flanders", desc: "Las originales papas fritas típicas del norte de Bélgica, servidas con catsup de curry, mayonesa y cebolla finamente picada.", precio: 95, foto: "/images/papas-flanders.png" },
    { nombre: "Papas Gajo", desc: "Acompañadas con aderezo y paprika.", precio: 110 },
    { nombre: "Papas a la Francesa", desc: "Acompañadas con aderezo especial de la casa y parmesano.", precio: 110 },
    { nombre: "Tiras de Pollo", desc: "Empanizadas, acompañadas de papas a la francesa, con salsa BBQ o Búfalo y aderezo Ranch de la casa.", precio: 165 },
    { nombre: "Entrada Vecindario", desc: "Hummus con pan pita, acompañado de costillas de elote amarillo con aderezo tártara y parmesano.", precio: 165 },
  ],
  pizzas: [
    { nombre: "Margarita", desc: "Salsa de tomate, mozzarella, albahaca y parmesano.", precio: 180 },
    { nombre: "Eureka", desc: "Pesto, mix de quesos, mozzarella fresco, calabaza laminada, queso de cabra, poros crispy, sal ahumada y ralladura de limón eureka.", precio: 235, foto: "/images/pizza-eureka.jpg" },
    { nombre: "Pizza Pera", desc: "Queso mozzarella, pera laminada, queso provolone, queso azul, miel, tomillo y parmesano.", precio: 230 },
    { nombre: "Pepperonata", desc: "Salsa de pimientos, mozzarella, quesos, pepperoni y parmesano.", precio: 210 },
    { nombre: "Prosciutto y arúgula", desc: "Margarita + prosciutto y arúgula.", precio: 235 },
  ],
  fuertes: [
    { nombre: "Pechuga Napolitana", desc: "Pechuga de pollo empanizada, salsa pomodoro, gratinada con queso mozzarella; incluye papas y ensalada de la casa.", precio: 235 },
    { nombre: "Queso Fundido", desc: "Con tortillas de harina, salsa de tomate asado y guacamole. De chorizo o champiñones (o arrachera premium +$40).", precio: 160 },
    { nombre: "Rib Eye (400 g)", desc: "Con chimichurri de la casa, ensalada de lechugas con parmesano y papas a la francesa.", precio: 455 },
    { nombre: "Burrito Estilo Norteño", desc: "Relleno de queso gouda, pimientos, cebolla morada, lechuga y aderezo de la casa, con salsa de tomate asado y guacamole. De pollo o champiñones (o arrachera premium +$40).", precio: 170 },
  ],
  hamburguesas: [
    { nombre: "Hamburguesa Vecindario", desc: "Pan brioche, queso americano, tocino, pepinillos, salsa BBQ, cebolla caramelizada.", precio: 195, foto: "/images/hamburguesa-vecindario.jpg" },
    { nombre: "Hamburguesa Teopanzolco", desc: "Pan brioche, chimichurri, mix de tres quesos y tocino.", precio: 185, foto: "/images/hamburguesa-teopanzolco.jpg" },
    { nombre: "Hamburguesa Vegetariana", desc: "Hecha con falafel empanizado, lechuga, tomate, cebolla caramelizada, salsa BBQ, pepinillos y papas a la francesa. Queso americano o cheddar opcional.", precio: 185, tag: "veg" },
    { nombre: "Torta de Suadero Confitado", desc: "Bolillo artesanal con queso gouda, acompañada de chips de camote y encurtidos de la casa.", precio: 185 },
    { nombre: "Sandwich de pulled pork", desc: "Pan brioche, carne de cerdo ahumada por 10 horas con madera de nogal, bañada en salsa BBQ de la casa, acompañada de queso americano, pepinillos y papas a la francesa.", precio: 180 },
  ],
  postres: [
    { nombre: "Brownie clásico", desc: "Acompañado con helado artesanal de vainilla con cardamomo.", precio: 140 },
    { nombre: "Nutizza", desc: "Pan de masa de pizza relleno de crema de avellanas con nueces tostadas, acompañado de duraznos en almíbar y ralladura de limón eureka.", precio: 140 },
    { nombre: "Crumble de manzana", desc: "Manzanas caramelizadas con mantequilla, azúcar morena, canela y especias, cubiertas por una crujiente galleta tipo crumble.", precio: 95 },
  ],
};

const bebidas = [
  { nombre: "Limonada, Mandarinada o Toronjada", precio: 75 },
  { nombre: "Rusa", precio: 60 },
  { nombre: "Kombucha embotellada", precio: 95 },
  { nombre: "Café americano", precio: 60 },
  { nombre: "Sanpellegrino", precio: 85 },
  { nombre: "Topo Chico 600 ml", precio: 65 },
  { nombre: "Coca Cola", precio: 58 },
  { nombre: "Coca Cola Zero", precio: 58 },
  { nombre: "Yoli", precio: 50 },
  { nombre: "Boing de Mango 354 ml", precio: 65 },
];

---

<BaseLayout
  title="Menú · Vecindario Beer Garden"
  description="Menú completo: 10 cervezas de barril en rotación, pizzas estilo napolitano, hamburguesas, entradas y otras bebidas."
  headerVariant="solid"
  schema={schema}
>
  <div class="menu-topbar">
    <div class="menu-topbar-inner">
      <span class="open-now">● ABIERTO AHORA</span>
      <div class="topbar-right">
        <a href={`tel:${site.telefonoTel}`}>{site.telefono}</a>
      </div>
    </div>
  </div>

  <!-- STICKY NAV (anchors, no tabs que esconden contenido) -->
  <nav class="menu-tabs">
    <div class="menu-tabs-inner">
      <a href="#taps" class="tab-btn active">Barril <span class="tab-count">10</span></a>
      <a href="#alimentos" class="tab-btn">Alimentos</a>
      <a href="#otras" class="tab-btn">Otras bebidas</a>
    </div>
  </nav>

  <div class="menu-body">

    <!-- CERVEZAS DE BARRIL -->
    <section id="taps" class="menu-section">
      <div class="section-head">
        <SectionLabel text="En rotación · actualizado hoy" />
        <h1 class="menu-title">Cervezas de barril</h1>
        <p class="menu-sub">Diez líneas con cervecerías mexicanas independientes. Lo que ves aquí es lo que hay ahora en la barra.</p>
      </div>
      <TapWall variant="full" />
      <div class="qr-banner">¿No sabes qué pedir? Pregunta al personal — te recomienda según tu gusto. <strong>La carta de barril está en rotación constante.</strong></div>
      <p class="section-more"><a href="/cerveza-artesanal-cuernavaca/">Más sobre nuestra cerveza artesanal →</a></p>
    </section>

    <!-- ALIMENTOS -->
    <section id="alimentos" class="menu-section">
      <div class="section-head">
        <SectionLabel text="Cocina casual" />
        <h2 class="menu-title">Alimentos</h2>
        <p class="menu-sub">Pizzas estilo napolitano, hamburguesas y entradas para compartir.</p>
      </div>

      <div class="cat-head"><h3>Para empezar</h3><span class="cat-count">14 opciones</span></div>
      {platos.empezar.map((p) => (
        <div class="plato-row">
          {p.foto ? (
            <button class="plato-thumb" data-foto={p.foto} data-nombre={p.nombre} aria-label={`Ver foto de ${p.nombre}`}>
              <img src={p.foto} alt={p.nombre} loading="lazy" />
            </button>
          ) : (
            <div class="plato-thumb-static">
              <img src="/assets/icono.svg" alt="" loading="lazy" />
            </div>
          )}
          <div class="plato-info">
            <div class="plato-name">{p.nombre}{p.tag && <span class="plato-tag-veg">{p.tag}</span>}</div>
            <div class="plato-desc">{p.desc}</div>
          </div>
          <div class="plato-price">{p.precio ? `$${p.precio}` : ''}</div>
        </div>
      ))}

      <div class="cat-head"><h3>Pizzas estilo napolitano</h3><span class="cat-count">5 opciones · para compartir</span></div>
      {platos.pizzas.map((p) => (
        <div class="plato-row">
          {p.foto ? (
            <button class="plato-thumb" data-foto={p.foto} data-nombre={p.nombre} aria-label={`Ver foto de ${p.nombre}`}>
              <img src={p.foto} alt={p.nombre} loading="lazy" />
            </button>
          ) : (
            <div class="plato-thumb-static">
              <img src="/assets/icono.svg" alt="" loading="lazy" />
            </div>
          )}
          <div class="plato-info">
            <div class="plato-name">{p.nombre}{p.tag && <span class="plato-tag-veg">{p.tag}</span>}</div>
            <div class="plato-desc">{p.desc}</div>
          </div>
          <div class="plato-price">{p.precio ? `$${p.precio}` : ''}</div>
        </div>
      ))}

      <p class="section-more"><a href="/pizzas-cuernavaca/">Más sobre nuestras pizzas →</a></p>

      <div class="cat-head"><h3>Platos fuertes</h3><span class="cat-count">4 opciones</span></div>
      {platos.fuertes.map((p) => (
        <div class="plato-row">
          <div class="plato-thumb-static">
            <img src="/assets/icono.svg" alt="" loading="lazy" />
          </div>
          <div class="plato-info">
            <div class="plato-name">{p.nombre}{p.tag && <span class="plato-tag-veg">{p.tag}</span>}</div>
            <div class="plato-desc">{p.desc}</div>
          </div>
          <div class="plato-price">{p.precio ? `$${p.precio}` : ''}</div>
        </div>
      ))}

      <div class="cat-head"><h3>Tortas y hamburguesas</h3><span class="cat-count">5 opciones · al momento</span></div>
      {platos.hamburguesas.map((p) => (
        <div class="plato-row">
          {p.foto ? (
            <button class="plato-thumb" data-foto={p.foto} data-nombre={p.nombre} aria-label={`Ver foto de ${p.nombre}`}>
              <img src={p.foto} alt={p.nombre} loading="lazy" />
            </button>
          ) : (
            <div class="plato-thumb-static">
              <img src="/assets/icono.svg" alt="" loading="lazy" />
            </div>
          )}
          <div class="plato-info">
            <div class="plato-name">{p.nombre}{p.tag && <span class="plato-tag-veg">{p.tag}</span>}</div>
            <div class="plato-desc">{p.desc}</div>
          </div>
          <div class="plato-price">{p.precio ? `$${p.precio}` : ''}</div>
        </div>
      ))}

      <p class="section-more"><a href="/hamburguesas-cuernavaca/">Más sobre nuestras hamburguesas →</a></p>

      <div class="cat-head"><h3>Postres</h3><span class="cat-count">3 opciones</span></div>
      {platos.postres.map((p) => (
        <div class="plato-row">
          {p.foto ? (
            <button class="plato-thumb" data-foto={p.foto} data-nombre={p.nombre} aria-label={`Ver foto de ${p.nombre}`}>
              <img src={p.foto} alt={p.nombre} loading="lazy" />
            </button>
          ) : (
            <div class="plato-thumb-static">
              <img src="/assets/icono.svg" alt="" loading="lazy" />
            </div>
          )}
          <div class="plato-info">
            <div class="plato-name">{p.nombre}{p.tag && <span class="plato-tag-veg">{p.tag}</span>}</div>
            <div class="plato-desc">{p.desc}</div>
          </div>
          <div class="plato-price">{p.precio ? `$${p.precio}` : ''}</div>
        </div>
      ))}
    </section>

    <!-- OTRAS BEBIDAS -->
    <section id="otras" class="menu-section">
      <div class="section-head">
        <SectionLabel text="Además de cerveza" />
        <h2 class="menu-title">Otras bebidas</h2>
      </div>

      <div class="cat-head"><h3>Aguas y café</h3></div>
      <div class="otras-list">
        <div class="otras-item"><span>Limonada, Mandarinada o Toronjada</span><span class="oi-price">$75</span></div>
        <div class="otras-item"><span>Rusa</span><span class="oi-price">$60</span></div>
        <div class="otras-item"><span>Kombucha embotellada</span><span class="oi-price">$95</span></div>
        <div class="otras-item"><span>Café americano</span><span class="oi-price">$60</span></div>
      </div>

      <div class="cat-head"><h3>Refrescos y embotellados</h3></div>
      <div class="otras-list">
        <div class="otras-item"><span>Sanpellegrino</span><span class="oi-price">$85</span></div>
        <div class="otras-item"><span>Topo Chico 600 ml</span><span class="oi-price">$65</span></div>
        <div class="otras-item"><span>Coca Cola</span><span class="oi-price">$58</span></div>
        <div class="otras-item"><span>Coca Cola Zero</span><span class="oi-price">$58</span></div>
        <div class="otras-item"><span>Yoli</span><span class="oi-price">$50</span></div>
        <div class="otras-item"><span>Boing de Mango 354 ml</span><span class="oi-price">$65</span></div>
      </div>
    </section>

  </div>

  <!-- LIGHTBOX -->
  <dialog id="lightbox" class="lightbox">
    <div class="lightbox-inner">
      <img id="lightbox-img" src="" alt="" />
      <button class="lightbox-close" id="lightbox-close" aria-label="Cerrar">×</button>
    </div>
  </dialog>
</BaseLayout>

<style>
  .menu-topbar { background: var(--vbg-negro); color: #9a9183; font-size: .78rem; padding: .4rem 0; position: relative; z-index: 101; margin-top: 60px; }
  .menu-topbar-inner { max-width: 900px; margin: 0 auto; padding: 0 1rem; display: flex; justify-content: space-between; align-items: center; font-family: 'JetBrains Mono', monospace; }
  .open-now { color: var(--vbg-verde-claro); font-weight: 600; animation: pulse 2.5s infinite; }
  .topbar-right a:hover { color: var(--vbg-ambar); }

  /* Tabs → anchors */
  .menu-tabs { background: var(--vbg-blanco); border-bottom: 1px solid var(--vbg-gris-linea); position: sticky; top: 0; z-index: 50; box-shadow: 0 2px 8px rgba(0,0,0,.06); }
  .menu-tabs-inner { max-width: 900px; margin: 0 auto; padding: 0 .5rem; display: flex; gap: 0; overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
  .menu-tabs-inner::-webkit-scrollbar { display: none; }
  .tab-btn { padding: .9rem 1rem; font-family: 'Poppins', sans-serif; font-size: .84rem; font-weight: 600; color: var(--vbg-gris-texto); white-space: nowrap; border-bottom: 3px solid transparent; transition: color .2s, border-color .2s; display: inline-flex; align-items: center; gap: .35rem; }
  .tab-btn:active { color: var(--vbg-verde); }
  .tab-btn.active { color: var(--vbg-verde); border-bottom-color: var(--vbg-ambar); }
  .tab-count { font-family: 'JetBrains Mono', monospace; font-size: .64rem; background: var(--vbg-claro); color: var(--vbg-ambar); padding: .1rem .35rem; border-radius: 2px; font-weight: 500; }

  .menu-body { max-width: 900px; margin: 0 auto; padding: 1.5rem 1rem 3rem; }
  .menu-section { scroll-margin-top: 60px; margin-bottom: 3rem; }
  .section-head { margin-bottom: 1.5rem; }
  .menu-title { font-family: 'Anton', sans-serif; font-weight: 400; text-transform: uppercase; font-size: clamp(1.5rem, 4vw, 2.1rem); color: var(--vbg-verde); line-height: 1; margin-bottom: .35rem; }
  .menu-sub { color: var(--vbg-gris-texto); font-size: .88rem; }

  .cat-head { display: flex; align-items: baseline; gap: .7rem; margin: 1.5rem 0 .4rem; padding-bottom: .4rem; border-bottom: 2px solid var(--vbg-verde-claro); }
  .cat-head h3 { font-family: 'Anton', sans-serif; font-weight: 400; text-transform: uppercase; font-size: 1.2rem; color: var(--vbg-verde); }
  .section-more { margin: 1rem 0 0; }
  .section-more a { color: var(--vbg-verde); font-weight: 600; font-size: .88rem; }
  .cat-count { font-family: 'JetBrains Mono', monospace; font-size: .68rem; color: var(--vbg-gris-texto); }

  .plato-row { display: grid; grid-template-columns: 56px 1fr auto; gap: .8rem; padding: .7rem 0; border-bottom: 1px dotted var(--vbg-gris-linea); align-items: center; }
  .plato-thumb { width: 56px; height: 56px; border-radius: 4px; overflow: hidden; border: none; padding: 0; cursor: pointer; background: var(--vbg-claro-2); flex-shrink: 0; }
  .plato-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform .3s; }
  .plato-thumb:hover img { transform: scale(1.1); }
  .plato-thumb-static { width: 56px; height: 56px; border-radius: 4px; overflow: hidden; background: var(--vbg-claro-2); flex-shrink: 0; }
  .plato-thumb-static img { width: 100%; height: 100%; object-fit: contain; padding: 10px; opacity: .5; }
  .plato-info { min-width: 0; }
  .plato-name { font-weight: 600; color: var(--vbg-carbon); font-size: .92rem; margin-bottom: .1rem; }
  .plato-desc { font-size: .8rem; color: var(--vbg-gris-texto); line-height: 1.4; }
  .plato-price { font-family: 'JetBrains Mono', monospace; font-weight: 600; color: var(--vbg-ambar); font-size: .98rem; white-space: nowrap; }
  .plato-tag-veg { display: inline-block; font-family: 'JetBrains Mono', monospace; font-size: .56rem; color: var(--vbg-verde-claro); border: 1px solid var(--vbg-verde-claro); padding: .05rem .3rem; border-radius: 2px; margin-left: .4rem; letter-spacing: .05em; text-transform: uppercase; vertical-align: middle; }


  .otras-list { display: grid; grid-template-columns: 1fr 1fr; gap: .2rem 1.5rem; }
  .otras-item { display: flex; justify-content: space-between; padding: .35rem 0; border-bottom: 1px dotted var(--vbg-gris-linea); font-size: .86rem; }
  .otras-item .oi-price { font-family: 'JetBrains Mono', monospace; color: var(--vbg-ambar); font-weight: 600; }

  .qr-banner { background: var(--vbg-verde); color: #f3ebd9; padding: .9rem; margin-top: 1.2rem; border-radius: 4px; font-size: .82rem; text-align: center; }
  .qr-banner strong { color: #fff; }

  .lightbox { border: none; padding: 0; background: none; max-width: none; max-height: none; margin: auto; }
  .lightbox::backdrop { background: rgba(0,0,0,.85); }
  .lightbox-inner { position: relative; }
  .lightbox-inner img { max-width: 90vw; max-height: 85vh; object-fit: contain; border-radius: 8px; display: block; }
  .lightbox-close { position: absolute; top: .4rem; right: .7rem; background: rgba(20,18,16,.7); border: none; color: #fff; font-size: 2rem; cursor: pointer; line-height: 1; z-index: 2; border-radius: 50%; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; }

  @media (max-width: 700px) {
    .otras-list { grid-template-columns: 1fr; }
    .plato-row { grid-template-columns: 48px 1fr auto; gap: .6rem; }
    .plato-thumb, .plato-thumb-static { width: 48px; height: 48px; }
    .plato-thumb-static img { padding: 8px; }
    /* Tabs en grid 2x2 para móvil (nada cortado) */
    .menu-tabs-inner { display: grid; grid-template-columns: 1fr 1fr; overflow: visible; }
    .tab-btn { justify-content: center; border-bottom: 3px solid transparent; }
    .tab-btn.active { border-bottom-color: var(--vbg-ambar); }
  }
</style>

<script>
  // Lightbox
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img');
  document.querySelectorAll('.plato-thumb').forEach(btn => {
    btn.addEventListener('click', () => {
      lightboxImg.src = btn.dataset.foto;
      lightboxImg.alt = btn.dataset.nombre;
      lightbox.showModal();
    });
  });
  lightbox.addEventListener('click', (e) => { if (e.target === lightbox) lightbox.close(); });
  document.getElementById('lightbox-close').addEventListener('click', () => lightbox.close());

  // Resaltar tab activa según sección visible
  const sections = document.querySelectorAll('.menu-section');
  const tabs = document.querySelectorAll('.tab-btn');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        tabs.forEach(t => t.classList.toggle('active', t.getAttribute('href') === `#${entry.target.id}`));
      }
    });
  }, { rootMargin: '-30% 0px -60% 0px' });
  sections.forEach(s => observer.observe(s));
</script>
