---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import FAQ from '../components/FAQ.astro';
import site from '../data/site.json';

const googleMaps = 'https://maps.google.com/?cid=4438131759649544388';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Tienen estacionamiento?",
      "acceptedAnswer": { "@type": "Answer", "text": "No tenemos estacionamiento propio. Te puedes estacionar sobre la Av. Teopanzolco." }
    },
    {
      "@type": "Question",
      "name": "¿Cómo llego a Vecindario Beer Garden?",
      "acceptedAnswer": { "@type": "Answer", "text": "Estamos sobre la Av. Teopanzolco 665, en la colonia Reforma de Cuernavaca, cerca de la zona arqueológica de Teopanzolco. Desde Jiutepec son 10 minutos por la autopista del Sol." }
    },
    {
      "@type": "Question",
      "name": "¿Puedo ir con niños o con mi perro?",
      "acceptedAnswer": { "@type": "Answer", "text": "Sí a ambos: somos un restaurante-bar familiar y la terraza es pet friendly, sin restricciones de tamaño ni raza." }
    },
    {
      "@type": "Question",
      "name": "¿Necesito reservar?",
      "acceptedAnswer": { "@type": "Answer", "text": "No es obligatorio, pero los fines de semana y eventos se llena. Reserva por WhatsApp para asegurar tu mesa." }
    }
  ]
};

const faqs = [
  { q: '¿Tienen estacionamiento?', a: 'No tenemos estacionamiento propio. Te puedes estacionar sobre la Av. Teopanzolco.' },
  { q: '¿Cómo llego a Vecindario Beer Garden?', a: 'Estamos sobre la <strong>Av. Teopanzolco 665</strong>, en la colonia Reforma de Cuernavaca, cerca de la zona arqueológica de Teopanzolco. Desde Jiutepec son 10 minutos por la autopista del Sol. <a href="' + googleMaps + '">Abrir en Google Maps →</a>' },
  { q: '¿Puedo ir con niños o con mi perro?', a: 'Sí a ambos: somos un restaurante-bar familiar y la <a href="/pet-friendly-cuernavaca/">terraza es pet friendly</a>, sin restricciones de tamaño ni raza.' },
  { q: '¿Necesito reservar?', a: 'No es obligatorio, pero los fines de semana y eventos se llena. <a href="https://wa.me/' + site.whatsapp + '">Reserva por WhatsApp</a> para asegurar tu mesa.' },
];
---

<BaseLayout
  title="Contacto y ubicación en Cuernavaca | Vecindario Beer Garden"
  description="Vecindario Beer Garden: Av. Teopanzolco 665, Reforma, Cuernavaca. Horarios, teléfono, WhatsApp y cómo llegar. Terraza pet friendly cerca de la zona arqueológica."
  headerVariant="solid"
  schema={faqSchema}
>
  <div class="menu-topbar" style="margin-top:60px;">
    <div class="menu-topbar-inner"><span class="open-now">● ABIERTO AHORA</span><div class="topbar-right"><a href={`tel:${site.telefonoTel}`}>{site.telefono}</a></div></div>
  </div>
  <div class="menu-body">
    <div class="section-head"><SectionLabel text="Visítanos" /><h1 class="menu-title">Contacto y ubicación</h1></div>

    <div class="contact-hero">
      <div>
        <h2>{site.direccion.calle}</h2>
        <p class="addr">{site.direccion.zona}, {site.direccion.cp} {site.direccion.ciudad}, {site.direccion.estado}</p>
        <div class="cta-row">
          <a href={`https://wa.me/${site.whatsapp}`} class="btn-primary">Reservar por WhatsApp</a>
          <a href={googleMaps} class="btn-secondary">Cómo llegar →</a>
        </div>
        <a class="rating-pill" href={googleMaps}>
          <span class="stars">★★★★★</span>
          <strong>{site.rating}</strong>
          <span>· {site.reseñas} reseñas en Google</span>
          <span class="ver">Ver perfil →</span>
        </a>
      </div>
      <div class="contact-side">
        <div>
          <h3>Horarios</h3>
          <div class="horarios">
            {site.horarios.map((h) => <div class="h-row"><span>{h.dia}</span><span>{h.abierto ? `${h.apertura}–${h.cierre}` : 'Cerrado'}</span></div>)}
          </div>
        </div>
        <div>
          <h3>Contacto directo</h3>
          <p><a href={`tel:${site.telefonoTel}`}>{site.telefono}</a></p>
          <p><a href={`https://wa.me/${site.whatsapp}`}>WhatsApp →</a></p>
          <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>
      </div>
    </div>

    <h3 style="margin-top:2.5rem;">Cómo llegar</h3>
    <div class="map-full"><iframe src={site.mapaIframe} loading="lazy" allowfullscreen="" title="Ubicación de Vecindario Beer Garden"></iframe></div>

    <div class="section-head" style="margin-top:3rem;"><SectionLabel text="Antes de venir" /><h2 class="faq-title">Preguntas frecuentes</h2></div>
    <FAQ items={faqs} />
  </div>
</BaseLayout>

<style>
  .menu-topbar { background: var(--vbg-negro); color: #9a9183; font-size: .78rem; padding: .4rem 0; }
  .menu-topbar-inner { max-width: 900px; margin: 0 auto; padding: 0 1.2rem; display: flex; justify-content: space-between; font-family: 'JetBrains Mono', monospace; }
  .open-now { color: var(--vbg-verde-claro); font-weight: 600; }
  .menu-body { max-width: 900px; margin: 0 auto; padding: 2rem 1.2rem 3.5rem; }
  .section-head { margin-bottom: 2rem; }
  .menu-title { font-family: 'Anton', sans-serif; font-weight: 400; text-transform: uppercase; font-size: 2.3rem; color: var(--vbg-verde); }
  .contact-hero { display: grid; grid-template-columns: 1.2fr 1fr; gap: 2.5rem; align-items: start; }
  h2 { font-family: 'Anton', sans-serif; font-weight: 400; text-transform: uppercase; font-size: 1.6rem; color: var(--vbg-verde); margin-bottom: .3rem; }
  .addr { color: var(--vbg-gris-texto); margin-bottom: 1.4rem; }
  .cta-row { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.4rem; }
  .btn-secondary { display: inline-block; padding: .8rem 1.6rem; border: 1px solid var(--vbg-verde); border-radius: 3px; color: var(--vbg-verde); font-weight: 600; font-size: .92rem; }
  .btn-secondary:hover { background: var(--vbg-verde); color: #fff; }
  .rating-pill { display: inline-flex; align-items: center; gap: .5rem; background: var(--vbg-blanco); border: 1px solid var(--vbg-gris-linea); border-radius: 4px; padding: .6rem 1rem; font-size: .85rem; color: var(--vbg-gris-texto); }
  .rating-pill .stars { color: var(--vbg-ambar); letter-spacing: 1px; }
  .rating-pill strong { color: var(--vbg-carbon); }
  .rating-pill .ver { color: var(--vbg-verde); font-weight: 600; margin-left: .3rem; }
  .contact-side { display: flex; flex-direction: column; gap: 1.8rem; }
  .contact-side h3 { font-family: 'Anton', sans-serif; font-weight: 400; text-transform: uppercase; font-size: 1.1rem; color: var(--vbg-verde); margin-bottom: .8rem; }
  .horarios .h-row { display: flex; justify-content: space-between; font-family: 'JetBrains Mono', monospace; font-size: .85rem; padding: .3rem 0; border-bottom: 1px dotted var(--vbg-gris-linea); }
  .contact-side p { margin-bottom: .5rem; }
  .contact-side a:hover { color: var(--vbg-ambar); }
  h3 { font-family: 'Anton', sans-serif; font-weight: 400; text-transform: uppercase; font-size: 1.2rem; color: var(--vbg-verde); margin-bottom: .5rem; }
  .faq-title { font-family: 'Anton', sans-serif; font-weight: 400; text-transform: uppercase; font-size: 1.6rem; color: var(--vbg-verde); }
  .map-full { width: 100%; height: 400px; border-radius: 4px; overflow: hidden; }
  .map-full iframe { width: 100%; height: 100%; border: 0; }
  @media (max-width: 700px) { .contact-hero { grid-template-columns: 1fr; gap: 2rem; } }
</style>
