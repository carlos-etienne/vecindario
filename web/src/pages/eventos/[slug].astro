---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import site from '../../data/site.json';
import eventos from '../../data/eventos.json';

export function getStaticPaths() {
  return eventos.map((e) => ({ params: { slug: e.slug }, props: { e } }));
}
const { e } = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: `2° Aniversario Vecindario Beer Garden: ${e.banda} + ${e.dj}`,
  startDate: e.startDate,
  endDate: e.endDate,
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  eventStatus: "https://schema.org/EventScheduled",
  image: [`https://vecindariobeergarden.com${e.img}`],
  description: e.descripcionLarga,
  location: {
    "@type": "Place",
    name: "Vecindario Beer Garden",
    address: {
      "@type": "PostalAddress",
      streetAddress: "Av. Teopanzolco 665, Zona 1, Reforma",
      addressLocality: "Cuernavaca",
      addressRegion: "Morelos",
      postalCode: "62260",
      addressCountry: "MX"
    },
    geo: { "@type": "GeoCoordinates", latitude: 18.9456493, longitude: -99.2251458 }
  },
  organizer: {
    "@type": "Organization",
    name: "Vecindario Beer Garden",
    url: "https://vecindariobeergarden.com"
  }
};
---

<BaseLayout
  title={`${e.titulo} | Eventos en Cuernavaca`}
  description={`${e.descripcion} Sábado ${e.dia} de septiembre desde las 6:00 PM en Vecindario Beer Garden, Cuernavaca.`}
  headerVariant="transparent"
  schema={schema}
>
  <section class="evento-hero">
    <div class="container hero-grid">
      <div class="hero-info">
        <SectionLabel text="Evento · Cuernavaca" />
        <div class="evento-top">
          <div class="evento-date"><span class="dow">SÁB</span><span class="day">{e.dia}</span><span class="month">SEP</span></div>
          <span class="evento-tag">{e.tag}</span>
        </div>
        <h1>{e.titulo}</h1>
        <p class="evento-meta">{e.meta} · Cupo limitado</p>
        <p class="evento-desc">{e.descripcionLarga}</p>
        <div class="cta-row">
          <a href={`https://wa.me/${site.whatsapp}?text=${encodeURIComponent(`Hola, quiero reservar para el aniversario del sábado ${e.dia} de septiembre`)}`} class="btn-primary">Reservar mesa por WhatsApp</a>
        </div>
      </div>
      <figure class="hero-img"><img src={e.img} alt={e.alt} /></figure>
    </div>
  </section>

  <section><div class="container">
    <div class="section-head"><SectionLabel text="En este evento" /><h2 class="section-title">Qué va a haber</h2></div>
    <div class="cards-grid">
      <div class="card">
        <h3>Música en vivo</h3>
        <p><strong>{e.banda}</strong> en vivo y sets a cargo de <strong>{e.dj}</strong>, desde las 6:00 PM y hasta el cierre.</p>
      </div>
      <div class="card">
        <h3>Cerveza conmemorativa</h3>
        <p>Presentamos nuestra cerveza de aniversario: una <strong>Italian Pilsner</strong> de edición limitada, con vaso de edición especial.</p>
      </div>
      <div class="card">
        <h3>Burgers especiales</h3>
        <p>Regresan dos best sellers: <strong>Lady Blue</strong> (mix de quesos, queso azul, cebolla con tocino caramelizado y aros de cebolla) y <strong>Salsa de Pimienta</strong> (res en brioche, cheddar y cebolla caramelizada sobre gravy de pimienta, con zanahorias baby a la mantequilla).</p>
      </div>
      <div class="card">
        <h3>Juegos y premios</h3>
        <p><strong>Dinámicas y premios</strong> toda la tarde para brindar por la comunidad que le da vida a Vecindario.</p>
      </div>
    </div>

    <div class="evento-lugar">
      <div>
        <h3>Vecindario Beer Garden</h3>
        <p>{site.direccion.completa} · Miércoles a domingo desde las 5:00 PM</p>
      </div>
      <a href={site.redes.google} class="btn-secondary">Cómo llegar →</a>
    </div>

    <p class="volver"><a href="/eventos/">← Ver todos los eventos</a></p>
  </div></section>
</BaseLayout>

<style>
  .evento-hero { background: var(--vbg-negro); padding: 6.5rem 0 4rem; color: #f3ebd9; }
  .hero-grid { display: grid; grid-template-columns: 1.2fr auto; gap: 3rem; align-items: center; }
  .evento-top { display: flex; align-items: center; gap: 1rem; margin: 0 0 1rem; }
  .evento-date { background: var(--vbg-verde); border-radius: 3px; padding: .55rem .8rem; text-align: center; display: flex; flex-direction: column; line-height: 1.05; }
  .evento-date .dow { font-family: 'JetBrains Mono', monospace; font-size: .58rem; color: var(--vbg-verde-claro); letter-spacing: .1em; }
  .evento-date .day { font-family: 'Anton', sans-serif; font-size: 2rem; color: #fff; }
  .evento-date .month { font-family: 'JetBrains Mono', monospace; font-size: .58rem; color: var(--vbg-verde-claro); letter-spacing: .1em; }
  .evento-tag { font-family: 'JetBrains Mono', monospace; font-size: .68rem; color: var(--vbg-ambar); border: 1px solid var(--vbg-ambar); padding: .25rem .55rem; border-radius: 2px; text-transform: uppercase; }
  h1 { font-family: 'Anton', sans-serif; font-weight: 400; text-transform: uppercase; font-size: clamp(1.7rem, 4vw, 2.6rem); margin-bottom: .5rem; }
  .evento-meta { font-family: 'JetBrains Mono', monospace; font-size: .8rem; color: var(--vbg-verde-claro); margin-bottom: 1.1rem; }
  .evento-desc { color: #c8c0b0; line-height: 1.7; max-width: 560px; margin-bottom: 1.6rem; }
  .cta-row { margin-bottom: 1rem; }
  .hero-img img { width: 300px; max-width: 100%; border-radius: 4px; box-shadow: 0 20px 50px rgba(0,0,0,.5); display: block; }
  section:not(.evento-hero) { padding: 3.5rem 0 4.5rem; background: var(--vbg-claro-2); }
  .section-title { font-family: 'Anton', sans-serif; font-weight: 400; text-transform: uppercase; font-size: 1.6rem; color: var(--vbg-verde); }
  .cards-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.2rem; }
  .card { background: var(--vbg-blanco); border: 1px solid var(--vbg-gris-linea); border-radius: 4px; padding: 1.5rem 1.4rem; border-top: 3px solid var(--vbg-verde-claro); }
  .card h3 { font-size: 1.05rem; color: var(--vbg-verde); margin-bottom: 0.6rem; }
  .card p { font-size: 0.9rem; color: var(--vbg-gris-texto); line-height: 1.6; }
  .card strong { color: var(--vbg-verde); }
  .evento-lugar { display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; flex-wrap: wrap; background: var(--vbg-blanco); border: 1px solid var(--vbg-gris-linea); border-radius: 4px; padding: 1.4rem 1.6rem; margin-top: 2rem; }
  .evento-lugar h3 { font-family: 'Anton', sans-serif; font-weight: 400; text-transform: uppercase; color: var(--vbg-verde); margin-bottom: .3rem; }
  .evento-lugar p { font-size: .9rem; color: var(--vbg-gris-texto); }
  .btn-secondary { display: inline-block; padding: .7rem 1.4rem; border: 1px solid var(--vbg-verde); border-radius: 3px; color: var(--vbg-verde); font-weight: 600; font-size: .9rem; }
  .btn-secondary:hover { background: var(--vbg-verde); color: #fff; }
  .volver { margin-top: 2.5rem; }
  .volver a { color: var(--vbg-verde); font-weight: 600; }
  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-img img { width: 260px; margin: 0 auto; }
    .cards-grid { grid-template-columns: 1fr; }
  }
</style>
