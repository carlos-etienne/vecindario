---
import BaseLayout from '../layouts/BaseLayout.astro';
import TapWall from '../components/TapWall.astro';
import SectionLabel from '../components/SectionLabel.astro';
import FAQ from '../components/FAQ.astro';
import site from '../data/site.json';
import eventos from '../data/eventos.json';

const faqs = [
  { q: '¿Son pet friendly?', a: 'Sí. Somos un restaurante y bar pet friendly con terraza abierta donde puedes venir con tu perro, grande o pequeño. Trae agua para tu mascota si gustas; si se te olvida, con gusto le damos un recipiente. <a href="/pet-friendly-cuernavaca/">Conoce nuestro espacio pet friendly →</a>' },
  { q: '¿Tienen terraza?', a: 'Sí. Nuestra terraza es uno de los espacios principales de Vecindario y es además el área ideal para venir con mascotas. Es un ambiente relajado, sin pretensiones, perfecto para disfrutar de una cerveza y algo de comer al aire libre.' },
  { q: '¿Qué tipo de cerveza tienen?', a: 'Tenemos diez cervezas artesanales de barril en rotación, además de una selección de cervezas en lata y botella de cervecerías nacionales e importadas. También servimos cervezas comerciales (Corona, Victoria, Heineken, Bohemia) y otras bebidas: mezcal, coctelería básica y bebidas sin alcohol. <a href="/cerveza-artesanal-cuernavaca/">Conoce nuestra selección de cerveza artesanal →</a>' },
  { q: '¿Qué se puede comer en Vecindario?', a: 'Nuestra cocina ofrece pizzas estilo napolitano, hamburguesas, entradas para compartir, postres y otras opciones. Es cocina casual pensada para acompañar la cerveza. <a href="/menu/">Ver el menú →</a>' },
  { q: '¿Es necesario reservar?', a: 'No es obligatorio, pero recomendamos reservar especialmente viernes, sábados y durante eventos especiales. Para asegurar mesa en horario pico, escríbenos por WhatsApp con anticipación. En horarios menos concurridos (miércoles, jueves temprano) normalmente hay lugar sin reserva.' },
  { q: '¿Pueden entrar menores de edad al restaurante?', a: 'Sí. Somos un restaurante-bar familiar donde los menores son bienvenidos. No se les sirve alcohol, pero pueden disfrutar de la cocina y el ambiente de terraza. Es un lugar apto para familias que buscan comer bien en Cuernavaca mientras los adultos disfrutan de una buena cerveza.' },
  { q: '¿Tienen opciones vegetarianas en el menú?', a: 'Sí. En el menú del restaurante tenemos opciones vegetarianas como ensaladas y la "Entrada Vecindario" que lleva hummus con pan pita y vegetales frescos. También contamos con una hamburguesa vegetariana de falafel empanizado. Si tienes una restricción específica, pregúntanos — la cocina se adapta cuando puede.' },
];

const schema = {
  "@context": "https://schema.org",
  "@type": ["BarOrPub", "Restaurant"],
  "@id": "https://vecindariobeergarden.com/#localbusiness",
  "name": site.nombre,
  "description": "Restaurante bar en Cuernavaca con cerveza artesanal, 10 cervezas de barril, pizzas, hamburguesas, terraza pet friendly.",
  "url": "https://vecindariobeergarden.com/",
  "image": "https://vecindariobeergarden.com/images/hero/tostada-hamburguesa-cerveza.jpg",
  "telephone": site.telefonoTel,
  "priceRange": "$$",
  "servesCuisine": ["Cerveza artesanal", "Pizza", "Hamburguesas"],
  "address": {
    "@type": "PostalAddress",
    "streetAddress": site.direccion.calle,
    "addressLocality": site.direccion.ciudad,
    "addressRegion": site.direccion.estado,
    "postalCode": site.direccion.cp,
    "addressCountry": "MX"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 18.9456493,
    "longitude": -99.2251458
  },
  "hasMap": site.mapaIframe.replace("https://www.google.com/maps/embed?pb=", "https://www.google.com/maps/place/"),
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Wednesday", "Thursday", "Friday"],
      "opens": "17:00",
      "closes": "23:30"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Saturday"],
      "opens": "15:00",
      "closes": "23:30"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Sunday"],
      "opens": "15:00",
      "closes": "22:00"
    }
  ],
  "sameAs": [
    site.redes.google,
    site.redes.instagram,
    site.redes.facebook
  ],
  "hasMenu": "https://vecindariobeergarden.com/menu/",
  "acceptsReservations": `https://wa.me/${site.whatsapp}`,
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": site.rating,
    "reviewCount": site.reseñas
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Son pet friendly?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí. Somos un restaurante y bar pet friendly con terraza abierta donde puedes venir con tu perro, grande o pequeño. Trae agua para tu mascota si gustas; si se te olvida, con gusto le damos un recipiente."
      }
    },
    {
      "@type": "Question",
      "name": "¿Tienen terraza?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí. Nuestra terraza es uno de los espacios principales de Vecindario y es además el área ideal para venir con mascotas. Es un ambiente relajado, sin pretensiones, perfecto para disfrutar de una cerveza y algo de comer al aire libre."
      }
    },
    {
      "@type": "Question",
      "name": "¿Qué tipo de cerveza tienen?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tenemos diez cervezas artesanales de barril en rotación, además de una selección de cervezas en lata y botella de cervecerías nacionales e importadas. También servimos cervezas comerciales (Corona, Victoria, Heineken, Bohemia) y otras bebidas: mezcal, coctelería básica y bebidas sin alcohol."
      }
    },
    {
      "@type": "Question",
      "name": "¿Qué se puede comer en Vecindario?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nuestra cocina ofrece pizzas estilo napolitano, hamburguesas, entradas para compartir, postres y otras opciones. Es cocina casual pensada para acompañar la cerveza."
      }
    },
    {
      "@type": "Question",
      "name": "¿Es necesario reservar?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No es obligatorio, pero recomendamos reservar especialmente viernes, sábados y durante eventos especiales. Para asegurar mesa en horario pico, escríbenos por WhatsApp con anticipación."
      }
    },
    {
      "@type": "Question",
      "name": "¿Pueden entrar menores de edad al restaurante?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí. Somos un restaurante-bar familiar donde los menores son bienvenidos. No se les sirve alcohol, pero pueden disfrutar de la cocina y el ambiente de terraza."
      }
    },
    {
      "@type": "Question",
      "name": "¿Tienen opciones vegetarianas en el menú?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí. En el menú tenemos opciones vegetarianas como ensaladas y la Entrada Vecindario que lleva hummus con pan pita y vegetales frescos. También contamos con una hamburguesa vegetariana de falafel empanizado."
      }
    }
  ]
};
---

<BaseLayout
  title="Restaurante Bar y Cerveza Artesanal en Cuernavaca | Vecindario Beer Garden"
  description="Restaurante bar en Cuernavaca con cerveza artesanal, 10 cervezas de barril, pizzas, hamburguesas, terraza pet friendly y eventos. Visítanos en Av. Teopanzolco."
  headerVariant="transparent"
  schema={[schema, faqSchema]}
>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg">
      <img src="/images/hero/tostada-hamburguesa-cerveza.jpg" alt="Tostadas, hamburguesa y cerveza de barril en Vecindario Beer Garden, restaurante bar en Cuernavaca" />
    </div>
    <div class="hero-inner">
      <div class="hero-text">
        <h1>Restaurante bar en <span class="accent">Cuernavaca</span></h1>
        <div class="hero-label">Restaurante bar · Cerveza artesanal · Cuernavaca</div>
        <p class="hero-sub">Restaurante bar con cocina casual, 10 líneas de cerveza artesanal de barril en rotación y una terraza pet friendly para comer, beber y disfrutar de una experiencia cervecera diferente en Cuernavaca.</p>
        <div class="hero-ctas">
          <a href="/menu/" class="btn-primary">Ver el menú <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
          <a href={`https://wa.me/${site.whatsapp}`} class="btn-wa" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.5 14.4c-.3-.1-1.7-.8-2-.9-.3-.1-.5-.1-.7.1-.2.3-.7.9-.9 1.1-.2.2-.3.2-.6.1-.3-.1-1.2-.5-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.1-.2.2-.3.2-.5.1-.2 0-.4 0-.5-.1-.1-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5 4.5.7.3 1.2.5 1.7.6.7.2 1.3.2 1.8.1.6-.1 1.7-.7 1.9-1.3.2-.7.2-1.2.2-1.3-.1-.2-.3-.2-.6-.4z"/><path d="M12 2C6.5 2 2 6.5 2 12c0 1.8.5 3.4 1.3 4.9L2 22l5.3-1.4c1.4.8 3 1.2 4.7 1.2 5.5 0 10-4.5 10-10S17.5 2 12 2zm0 18.3c-1.5 0-2.9-.4-4.2-1.1l-.3-.2-3.1.8.8-3-.2-.3c-.8-1.3-1.2-2.8-1.2-4.4 0-4.6 3.7-8.3 8.3-8.3s8.3 3.7 8.3 8.3-3.8 8.2-8.4 8.2z" fill-rule="evenodd"/></svg> Reservar por WhatsApp</a>
        </div>
        <div class="hero-badge-row">
          <span class="hero-rating"><span class="stars">★★★★★</span><strong>{site.rating}</strong><span>· {site.reseñas} reseñas en Google</span></span>
        </div>
      </div>
    </div>
  </section>

  <!-- TAP WALL -->
  <div class="tapwall-float">
    <div class="tapwall-heading">
      <SectionLabel text="En rotación · 10 líneas" color="var(--vbg-verde-claro)" />
      <h2 class="tapwall-title">Cerveza artesanal de barril en rotación</h2>
    </div>
    <TapWall variant="compact" />
  </div>

  <!-- COCINA -->
  <section class="cocina"><div class="container">
    <div class="section-head"><SectionLabel text="Lo que sale de la cocina" /><h2 class="section-title">Qué comer en Vecindario</h2><p class="section-sub">Pizzas estilo napolitano, hamburguesas y entradas para compartir. Una cocina casual pensada para disfrutar con nuestra selección de cerveza artesanal.</p></div>
    <div class="cocina-grid">
      <a href="/pizzas-cuernavaca/" class="plato-card"><div class="plato-img"><img src="/images/pizza-eureka.jpg" alt="Pizzas estilo napolitano en Cuernavaca" /></div><div class="plato-body"><div class="plato-tag">Del horno</div><h3>Pizzas estilo napolitano</h3><p>Masa de fermentación larga, salsa de tomate y mozzarella.</p><div class="plato-foot"><span class="plato-pair">Ver nuestras pizzas →</span></div></div></a>
      <a href="/hamburguesas-cuernavaca/" class="plato-card"><div class="plato-img"><img src="/images/hamburguesa-vecindario.jpg" alt="Hamburguesas en Cuernavaca" /></div><div class="plato-body"><div class="plato-tag">Cocinadas al momento</div><h3>Hamburguesas</h3><p>Pan brioche, tres recetas de la casa y especiales que salen de vez en cuando.</p><div class="plato-foot"><span class="plato-pair">Ver nuestras hamburguesas →</span></div></div></a>
      <a href="/menu/" class="plato-card"><div class="plato-img"><img src="/images/tostadas-de-atun.jpg" alt="Entradas para compartir" /></div><div class="plato-body"><div class="plato-tag">Para compartir</div><h3>Entradas</h3><p>Tostadas de atún, papas gajo, tiras de pollo y más para empezar la noche.</p><div class="plato-foot"><span class="plato-pair">Ver el menú completo →</span></div></div></a>
    </div>
  </div></section>

  <!-- DIFERENCIADORES -->
  <section class="diferenciadores"><div class="container">
    <div class="section-head"><SectionLabel text="Por qué Vecindario" /><h2 class="section-title">Lo que hace diferente a Vecindario</h2></div>
    <div class="dif-grid">
      <div class="dif-card"><svg class="dif-icon" viewBox="0 0 24 24"><path fill="currentColor" d="M12 5c4.97 0 9 2.69 9 6c0 1.68-1.04 3.2-2.71 4.29c1.07-.87 1.71-1.97 1.71-3.16C20 9.29 16.42 7 12 7v3L8 6l4-4zm0 14c-4.97 0-9-2.69-9-6c0-1.68 1.04-3.2 2.71-4.29C4.64 9.58 4 10.68 4 11.88C4 14.71 7.58 17 12 17v3l4-4l-4 4z" /></svg><div class="dif-num">10 LÍNEAS</div><h3 class="dif-title">Cervezas que siempre cambian</h3><p>Diez líneas de barril con cervecerías independientes que cambian constantemente para que siempre haya algo nuevo por descubrir.</p></div>
      <div class="dif-card"><svg class="dif-icon" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="1.5"><path stroke-linecap="round" d="m21 14.25l-.831-.659c-.946-.75-1.419-1.125-1.419-1.591s.473-.841 1.419-1.591L21 9.75m-18 0l.831.659c.946.75 1.419 1.125 1.419 1.591s-.473.841-1.419 1.591L3 14.25M14.572 21l.156-1.059c.178-1.205.267-1.807.674-2.042c.407-.236.972-.011 2.104.437l.994.394M9.428 3l-.156 1.059c-.178 1.205-.267 1.807-.674 2.042c-.407.236-.972.011-2.104-.437L5.5 5.27M5 18.732l1.07-.395c1.218-.448 1.827-.672 2.265-.438s.533.838.724 2.042L9.227 21M19 5.268l-1.07.394c-1.218.45-1.828.673-2.265.439s-.533-.838-.724-2.042L14.773 3" /><path d="M19 12H5m10.5 6l-7-12m7 0l-7 12" /></g></svg><div class="dif-num">ÚNICOS EN MORELOS</div><h3 class="dif-title">Cámara fría cervecera</h3><p>La única cámara fría cervecera del estado para conservar y servir la cerveza en condiciones óptimas.</p></div>
      <div class="dif-card"><svg class="dif-icon" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5M8.136 10.832s1.864.672 3.535 3.536C15 8.504 20.864 5.176 20.864 5.176" /></svg><div class="dif-num">EQUIPO CERVECERO</div><h3 class="dif-title">Te ayudamos a elegir</h3><p>¿No conoces un estilo? Cuéntanos qué te gusta y te recomendamos.</p></div>
      <div class="dif-card"><svg class="dif-icon" viewBox="0 0 24 24"><path fill="currentColor" fill-rule="evenodd" d="M6.5 5c0-1.47.955-3 2.5-3s2.5 1.53 2.5 3s-.955 3-2.5 3s-2.5-1.53-2.5-3M9 3.5c-.388 0-1 .485-1 1.5s.612 1.5 1 1.5s1-.485 1-1.5s-.612-1.5-1-1.5M2 10c0-1.47.955-3 2.5-3S7 8.53 7 10s-.955 3-2.5 3S2 11.47 2 10m2.5-1.5c-.388 0-1 .485-1 1.5s.612 1.5 1 1.5s1-.485 1-1.5s-.612-1.5-1-1.5M15 2c-1.545 0-2.5 1.53-2.5 3s.955 3 2.5 3s2.5-1.53 2.5-3s-.955-3-2.5-3m-1 3c0-1.015.612-1.5 1-1.5s1 .485 1 1.5s-.612 1.5-1 1.5s-1-.485-1-1.5m3 5c0-1.47.955-3 2.5-3S22 8.53 22 10s-.955 3-2.5 3s-2.5-1.53-2.5-3m2.5-1.5c-.388 0-1 .485-1 1.5s.612 1.5 1 1.5s1-.485 1-1.5s-.612-1.5-1-1.5M12 9c-1.412 0-2.3.655-2.937 1.479c-.303.392-.553.827-.776 1.225l-.1.18c-.191.343-.365.657-.561.95c-.185.277-.455.532-.818.826q-.147.12-.32.255c-.278.218-.59.463-.87.72C4.761 15.42 4 16.483 4 18.25C4 20.32 5.68 22 7.75 22c.944 0 1.779-.456 2.42-.807l.064-.035c.726-.396 1.242-.658 1.766-.658s1.04.262 1.766.658l.064.035c.641.35 1.476.807 2.42.807c2.07 0 3.75-1.68 3.75-3.75c0-1.767-.76-2.83-1.618-3.615a15 15 0 0 0-.87-.72q-.173-.135-.32-.255c-.363-.294-.633-.549-.818-.826a14 14 0 0 1-.56-.95l-.1-.18c-.224-.399-.474-.833-.777-1.225C14.301 9.655 13.412 9 12 9m-3.126 4.666c.232-.348.44-.722.629-1.062l.093-.168c.222-.398.425-.745.654-1.04c.426-.551.912-.896 1.75-.896s1.324.345 1.75.896c.229.295.431.642.654 1.04l.093.168c.19.34.397.714.629 1.062c.315.473.732.843 1.12 1.158q.206.167.394.314c.255.2.491.385.728.602c.643.59 1.132 1.277 1.132 2.51c0 1.24-1.01 2.25-2.25 2.25c-.524 0-1.04-.262-1.766-.658l-.064-.035C13.78 19.457 12.944 19 12 19s-1.779.456-2.42.807l-.064.035c-.726.396-1.242.658-1.766.658c-1.24 0-2.25-1.01-2.25-2.25c0-1.233.49-1.92 1.132-2.51c.237-.217.473-.402.728-.602q.188-.148.394-.314c.388-.315.805-.685 1.12-1.158" clip-rule="evenodd" /></svg><div class="dif-num">TERRAZA</div><h3 class="dif-title">Terraza pet friendly</h3><p>Ven con tu perro y disfruta de nuestra terraza abierta. <a href="/pet-friendly-cuernavaca/" style="color:var(--vbg-verde);font-weight:600;">Conoce nuestro espacio pet friendly →</a></p></div>
    </div>
  </div></section>

  <!-- RESEÑAS -->
  <section class="reviews"><div class="container">
    <div class="section-head"><SectionLabel text={site.rating + ' en Google'} /><h2 class="section-title">Lo que dicen nuestros clientes</h2></div>
    <div class="reviews-summary"><div class="reviews-score">{site.rating}<small>/5</small></div><div class="reviews-meta"><div class="stars">★★★★★</div><div class="count">{site.reseñas} reseñas en Google</div></div><a class="reviews-source" href={site.redes.google}>Ver Google Business Profile ↗</a></div>
    <div class="reviews-slider" id="reviewsSlider">
      <div class="review-card"><p>"Súper genial la atención y el lugar, te da una vibra tan agradable que en serio quiero volver más veces."</p><div class="review-author">Ernesto Morales</div></div>
      <div class="review-card"><p>"Un lugar muy agradable con gran variedad de cervezas internacionales y nacionales para probar, la pizza estuvo muy deliciosa y el ambiente es tranquilo."</p><div class="review-author">Kike Aranda</div></div>
      <div class="review-card"><p>"Excelente servicio, excelente cocina, cervezas frías."</p><div class="review-author">Cándido Mendoza</div></div>
      <div class="review-card"><p>"Tuve una experiencia muy agradable en este tap room, los alimentos, el servicio y los barriles de cerveza 10/10. Además tienen más cervezas en lata y botella por si no es suficiente con sus 10 barriles."</p><div class="review-author">Jessica Acevedo</div></div>
      <div class="review-card"><p>"De los mejores lugares a los que he ido en muchos aspectos (calidad, variedad, precio, ambiente y eventos), pero la principal es: la atención. Realmente un trato muy bueno, gente conocedora sobre el ramo cervecero. La comida es muy buena. Ampliamente recomendado."</p><div class="review-author">Antonio González Pineda</div></div>
      <div class="review-card"><p>"El mejor lugar de chelas internacionales de Morelos, no le pide nada a los mejores de CDMX. Además la comida es buenísima y la atención de lo mejor."</p><div class="review-author">Rodrigo Villamil</div></div>
    </div>
    <div class="slider-nav">
      <button onclick="document.getElementById('reviewsSlider').scrollBy({left:-320,behavior:'smooth'})" aria-label="Anterior"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg></button>
      <button onclick="document.getElementById('reviewsSlider').scrollBy({left:320,behavior:'smooth'})" aria-label="Siguiente"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg></button>
    </div>
  </div></section>

  <!-- EVENTOS -->
  <section class="eventos"><div class="container">
    <div class="section-head"><SectionLabel text="Próximos eventos" /><h2 class="section-title">Próximos eventos en Cuernavaca</h2><p class="section-sub">2° Aniversario: dos sábados de música en vivo, cerveza conmemorativa y burgers especiales. <a href="/eventos/" style="color:var(--vbg-verde);font-weight:600;">Ver todos los eventos →</a></p></div>
    <div class="eventos-grid">
      {eventos.map((e) => (
        <a class="evento-card" href={`/eventos/${e.slug}/`}>
          <div class="evento-img"><img src={e.img} alt={e.alt} loading="lazy" /></div>
          <div><div class="evento-tag">{e.tag}</div><h3 class="evento-name">{e.titulo}</h3><p class="evento-meta">{e.meta}</p></div>
        </a>
      ))}
    </div>
  </div></section>

  <!-- FAQ -->
  <section class="faq"><div class="container-narrow">
    <div class="section-head" style="text-align:center;"><SectionLabel text="Antes de tu visita" centered={true} /><h2 class="section-title">Preguntas frecuentes</h2></div>
    <FAQ items={faqs} />
  </div></section>

  <!-- UBICACIÓN + MAPA -->
  <section id="mapa" class="visitanos">
    <div class="container">
      <SectionLabel text="Ven a visitarnos" color="var(--vbg-verde-claro)" />
      <h2 class="section-title" style="color:#f3ebd9;">Dónde encontrarnos en Cuernavaca</h2>
      <p style="color:#c8c0b0;max-width:620px;margin-top:0.6rem;">Estamos sobre Av. Teopanzolco, en la zona de Reforma, Cuernavaca, Morelos. Consulta nuestro horario y cómo llegar.</p>
