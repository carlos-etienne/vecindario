<script>
  const slider = document.getElementById('reviewsSlider');
  if (slider) {
    let auto;
    const start = () => { auto = setInterval(() => { if (slider.scrollLeft + slider.clientWidth >= slider.scrollWidth - 10) slider.scrollTo({left:0,behavior:'smooth'}); else slider.scrollBy({left:320,behavior:'smooth'}); }, 5000); };
    start(); slider.addEventListener('mouseenter', () => clearInterval(auto)); slider.addEventListener('mouseleave', start);
  }
</script>
