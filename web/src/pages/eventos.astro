---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import site from '../data/site.json';
import eventos from '../data/eventos.json';
---

<BaseLayout
  title="Eventos en Cuernavaca | Vecindario Beer Garden"
  description="Agenda de eventos en Vecindario Beer Garden, Cuernavaca: música en vivo, catas de cerveza y noches especiales. Próximos: festejos de 2° aniversario, sábados 5 y 12 de septiembre."
  headerVariant="transparent"
>

  <section class="page-head">
    <div class="container">
      <SectionLabel text="Agenda" />
      <h1>Eventos en Cuernavaca</h1>
      <p class="page-sub">La agenda de Vecindario: música en vivo, catas de cerveza y noches especiales. Reserva por WhatsApp — los eventos tienen cupo limitado.</p>
    </div>
  </section>

  <section><div class="container">
    <div class="section-head"><SectionLabel text="Próximos eventos" /><h2 class="section-title">2° Aniversario: dos sábados de festejo</h2></div>
    <div class="eventos-grid">
      {eventos.map((e) => (
        <a class="evento-card" href={`/eventos/${e.slug}/`}>
          <div class="evento-img"><img src={e.img} alt={e.alt} loading="lazy" /></div>
          <div class="evento-body">
            <div class="evento-top">
              <div class="evento-date"><span class="dow">SÁB</span><span class="day">{e.dia}</span><span class="month">SEP</span></div>
              <span class="evento-tag">{e.tag}</span>
            </div>
            <h2 class="evento-name">{e.titulo}</h2>
            <p class="evento-meta">{e.meta}</p>
            <p class="evento-desc">{e.descripcion}</p>
            <span class="evento-ver">Ver detalles →</span>
          </div>
        </a>
      ))}
    </div>
  </div></section>
</BaseLayout>

<style>
  .page-head { background: var(--vbg-negro); padding: 7rem 0 3.5rem; }
  .page-head h1 { font-family: 'Anton', sans-serif; font-weight: 400; text-transform: uppercase; font-size: clamp(1.8rem, 4vw, 2.6rem); color: #f3ebd9; margin-bottom: .5rem; }
  .page-sub { color: #c8c0b0; max-width: 560px; }
  section:not(.page-head) { padding: 2.5rem 0 4.5rem; }
  .section-title { font-family: 'Anton', sans-serif; font-weight: 400; text-transform: uppercase; font-size: 1.6rem; color: var(--vbg-verde); }
  .eventos-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
  .evento-card { display: grid; grid-template-columns: 220px 1fr; background: var(--vbg-blanco); border: 1px solid var(--vbg-gris-linea); border-radius: 4px; overflow: hidden; transition: border-color .2s, transform .2s, box-shadow .2s; }
  .evento-card:hover { border-color: var(--vbg-ambar); transform: translateY(-2px); box-shadow: 0 8px 25px rgba(0,0,0,.08); }
  .evento-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .evento-body { padding: 1.3rem 1.4rem; }
  .evento-top { display: flex; align-items: center; gap: 1rem; margin-bottom: .8rem; }
  .evento-date { background: var(--vbg-verde); border-radius: 3px; padding: .5rem .7rem; text-align: center; display: flex; flex-direction: column; line-height: 1.05; }
  .evento-date .dow { font-family: 'JetBrains Mono', monospace; font-size: .56rem; color: var(--vbg-verde-claro); letter-spacing: .1em; }
  .evento-date .day { font-family: 'Anton', sans-serif; font-size: 1.7rem; color: #fff; }
  .evento-date .month { font-family: 'JetBrains Mono', monospace; font-size: .56rem; color: var(--vbg-verde-claro); letter-spacing: .1em; }
  .evento-tag { font-family: 'JetBrains Mono', monospace; font-size: .66rem; color: var(--vbg-ambar); border: 1px solid var(--vbg-ambar); padding: .2rem .5rem; border-radius: 2px; text-transform: uppercase; }
  .evento-name { font-family: 'Anton', sans-serif; font-weight: 400; text-transform: uppercase; font-size: 1.25rem; color: var(--vbg-verde); margin-bottom: .3rem; }
  .evento-meta { font-family: 'JetBrains Mono', monospace; font-size: .74rem; color: var(--vbg-gris-texto); margin-bottom: .7rem; }
  .evento-desc { font-size: .9rem; color: var(--vbg-gris-texto); line-height: 1.6; margin-bottom: .9rem; }
  .evento-ver { color: var(--vbg-verde); font-weight: 600; font-size: .88rem; }
  @media (max-width: 900px) {
    .eventos-grid { grid-template-columns: 1fr; }
    .evento-card { grid-template-columns: 1fr; }
    .evento-img { aspect-ratio: 16/10; }
  }
</style>
